# Copy this file to ".env.local" and fill in real values.
# .env.local is gitignored — never commit real keys.

# Supabase → Project Settings → Data API / API Keys
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# Server-only secret key (sb_secret_...). Used by scripts/cleanup-images.mjs
# (`npm run cleanup`, and the GitHub Action via a repo secret) to delete image
# files once their 3-day window ends. NEVER expose to the browser.
# SUPABASE_SERVICE_ROLE_KEY=YOUR-SECRET-KEY

# TURN relay for video calls across different networks (school Wi-Fi ↔ home/
# cellular). Without it, calls only connect when peers reach each other directly
# (STUN). These live as secrets on the `turn` Supabase Edge Function
# (supabase/functions/turn) — they're listed here only for reference.
# METERED_API_KEY: a TURN credential's apiKey. Create one in Metered → TURN
#   Server, or POST https://<app>.metered.live/api/v1/turn/credential?secretKey=
# METERED_TURN_DOMAIN: Metered → Developers → Metered Domain.
# METERED_API_KEY=your-turn-credential-apikey
# METERED_TURN_DOMAIN=your-app.metered.live
